# MSG91 (OTP)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=SARIO

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
